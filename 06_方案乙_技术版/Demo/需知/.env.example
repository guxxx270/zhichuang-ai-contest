# 可选：本地调试兜底（已 gitignore）。推荐在页面上选模型并填写 API Key，不要把 key 写进代码。
# Web 页（启动需知.command / streamlit run app.py）默认只在 127.0.0.1 监听（.streamlit/config.toml，不在本文件）；
# 页面没有登录，要局域网访问先放到带鉴权的反向代理后面再改。
# 公司 AI 平台等自定义网关：三项都填上，页面会默认选「自定义网关」并带出网关与模型；Key 只在服务端使用、页面不显示（页面上填了 Key 则以页面为准）。
# LLM_API_BASE=https://api.siliconflow.cn/v1
# LLM_API_KEY=
# LLM_MODEL=  # 可空；硅基流动 / OpenAI / Fable / Qoder 在页面填 Key 后从 GET /models 实时选
# LLM_MODE=auto              # mock = 强制只走规则引擎（现场网络不稳时用）：不再使用上面的 Key，页面上手填的模型照常可用
# LLM_TIMEOUT=90             # 单次模型调用上限（秒）；连接 10 秒连不上即放弃，超时后 2 分钟内其余步骤直接走规则引擎
# LLM_MAX_TOKENS=            # 单次输出上限；空或 0 = 不传，按网关默认。输出被截断时估时报「模型输出被截断」，不当成格式错误
# FABLE_API_BASE=https://your-fable-host/v1  # Fable OpenAI 兼容网关

# ---------- 企微入口（xuzhi.channels.wecom）----------
# 企微后台：安全与管理 → 管理工具 → 智能机器人 → 手动创建 → API 模式 → 连接方式选「使用长连接」
# 长连接由本机主动连出去，内网无需公网回调地址。Secret 只显示一次，丢了在机器人详情页重新生成。
# WECOM_BOT_ID=
# WECOM_BOT_SECRET=
# WECOM_BOT_NAME=需知                # 群聊里剥掉 "@名字 " 前缀用
# WECOM_ALLOW_USERS=                # 允许使用的 userid，逗号分隔；机器人非超管创建时是加密 id，启动后发 /whoami 查
# WECOM_ALLOW_CHATS=                # 可选：只允许这些群 chatid；留空=不限群
# WECOM_AUTH_MODE=whitelist         # allow_all = 跳过白名单（仅本机调试），只有 sandbox.yaml wecom.auth_mode 也是 allow_all 时才生效
# 白名单模式与下面的问码目录、轮数、墙钟都以 sandbox.yaml 为准：这里只能比它更严，放宽的值忽略并在日志里告警
# WECOM_PROXY=none                  # none 直连（默认）；内网必须经代理时填 env 或 http://host:port
# WECOM_MAX_CONCURRENT=3            # 企微限制同一机器人最多 3 个并发交互
# WECOM_ANALYZE_TIMEOUT=240         # 单条需求处理上限（秒），企微流式上限 6 分钟
# WECOM_MIN_CHARS=15                # 短于此字数且不像命令/答复 → 回引导语

# ---------- 问码：基于需知自己的代码库回答问题 ----------
# 走 Claude Agent SDK（Anthropic 格式），和上面需求分析用的 OpenAI 兼容口是两套接口，
# 同一个中转站通常两套都能服务：BASE_URL 这里不要带 /v1。
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=
# WECOM_ASK_ENABLED=1        # 0 关掉问码
# WECOM_ASK_REPO=            # 空=需知 Demo 根目录；sandbox.yaml askcode.cwd_locked=true（默认）时只能是 Demo 目录或其子目录，指到外面会被忽略
# WECOM_ASK_MAX_TURNS=20     # 最多翻多少步；只能调小，上限 sandbox.yaml askcode.max_turns
# WECOM_ASK_TIMEOUT=240      # 单次问码墙钟上限（秒）；只能调小，上限 sandbox.yaml askcode.wall_clock_seconds
# WECOM_ASK_MODEL=           # 空=SDK 默认
# WECOM_DEFAULT_MODE=req     # req 需求分析（默认）| ask 开机即问码

# ---------- REST API / MCP（api.py / mcp_server.py）----------
# XUZHI_API_HOST=127.0.0.1   # 默认只听本机（sandbox.yaml api.bind）；改成 0.0.0.0 对外时必须配下面的 Token，否则拒绝启动
# XUZHI_API_PORT=8770
# XUZHI_API_TOKEN=           # 配了就要求 Authorization: Bearer <token> 或 X-API-Token
# XUZHI_MCP_PORT=8771        # 仅 --transport streamable-http 时用
# XUZHI_MCP_HOST=127.0.0.1   # MCP HTTP 默认只听本机；改成对外地址时要放在带鉴权的公司网关之后，并设下面一项，否则拒绝启动
# XUZHI_MCP_ALLOW_EXPOSED=   # 1 = 已放在带鉴权的网关之后，允许 MCP HTTP 对外监听
# XUZHI_MCP_ALLOWED_HOSTS=   # MCP HTTP 对外时放行的 Host（网关转发时带的，逗号分隔，如 mcp.corp.example,10.0.0.5:8771；不写端口则任意端口）；空 = 只认监听地址，本机始终可连
# XUZHI_LEDGER_DB=           # 一本账 / 追问记忆 / 调用审计 的 SQLite 位置，空 = data/ledger.sqlite3
# XUZHI_HISTORY_LEARNED=     # 对账回写的历史记录参考 JSON；空 = 一本账同目录的 history_learned.json（换了库位置就跟着走）

# ---------- 页面底稿 / Git 仓库 ----------
# XUZHI_GIT_SSL_NO_VERIFY=   # 1 = 拉仓库时不校验 HTTPS 证书（只给证书不受信的自建 GitLab，与页面上「跳过 SSL 校验」开关作用相同），默认校验

# ---------- 催办摘要（附加功能，默认不推送）----------
# 推送要三把锁同时打开：sandbox.yaml notify.enabled=true + 下面的 webhook + （定时的话）时间
# XUZHI_DIGEST_WEBHOOK=      # 企微「群机器人」webhook（群 → 添加群机器人 → 复制地址）；只发数量、标题、天数
# XUZHI_DIGEST_TIME=         # 如 09:00：企微入口进程每日定时推；留空 = 不定时（聊天里 /摘要 随时拉）
